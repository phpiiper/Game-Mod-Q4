	onInit {
		namedEvent "switchToArenaWindow";
	}

	onNamedEvent switchToArenaWindow {
		set "ArenaWindow::visible" "1" ;
		set "RunesWindow::visible" "0" ;
		set "Runes2Window::visible" "0" ;
		set "AboutWindow::visible" "0" ;
	}

	onNamedEvent switchToRunesWindow {
		set "ArenaWindow::visible" "0" ;	
		set "RunesWindow::visible" "1" ;
		set "Runes2Window::visible" "0" ;
		set "AboutWindow::visible" "0" ;
	}

	onNamedEvent switchToRunes2Window {
		set "ArenaWindow::visible" "0" ;	
		set "RunesWindow::visible" "0" ;
		set "Runes2Window::visible" "1" ;
		set "AboutWindow::visible" "0" ;
	}

	onNamedEvent switchToAboutWindow {
		set "ArenaWindow::visible" "0" ;
		set "RunesWindow::visible" "0" ;
		set "Runes2Window::visible" "0" ;
		set "AboutWindow::visible" "1" ;
	}

