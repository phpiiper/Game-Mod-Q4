	onNamedEvent updatePLPUI {
		set "ar_en_text::text" "$gui::EnemiesLeft";
		set "ar_round_text::text" "$gui::Round";
		
		if ("gui::inRound"){
			set "ar_en_text::visible" "1";
			set "ar_round_text::visible" "1";
		} else {
			set "ar_en_text::visible" "0";
			set "ar_round_text::visible" "0";
		}

		if ("gui::bought_item_rune_fire_i" == 1){
			set "ru_bbtn_fire_i::text" "Sold";
			set "ru_ebtn_fire_i::visible" "1";
			if ("gui::activated_item_rune_fire_i" == 1){
				set "ru_ebtn_fire_i::text" "Unequip";
			} else {
				set "ru_ebtn_fire_i::text" "Equip";
			}
		} else {
			set "ru_bbtn_fire_i::text" "Buy";
			set "ru_ebtn_fire_i::visible" "0";
		}
